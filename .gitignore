# Build output. m2-sdk.dll and its import library are reproducible from source, and a committed
# binary is the thing consumers accidentally bind against instead of the one they just built.
build/

# Consumer smoke-test output.
test/consumer/*.asi

.DS_Store
Thumbs.db

# The Shipment's staged runtime DLL: manifest.yaml declares src/m2-sdk.dll, which is a copy of
# build/m2-sdk.dll made after `make build` (by CI, by the release, or by hand before running qm).
/src/
